{
  "expo": {
    "name": "Aurora",
    "slug": "app-asistente-depresion",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#101a2d"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a la aplicación acceder a tu ubicación para encontrar Centros de Salud Mental Comunitarios cercanos en Cusco durante una situación de apoyo."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permite grabar tu voz para que puedas conversar hablando con el asistente en lugar de escribir."
        }
      ],
      "expo-sharing"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101a2d",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para buscar centros de salud mental cercanos en Cusco."
      }
    },
    "android": {
      "package": "com.rdo0711.aurora",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101a2d"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "831b13b0-5f02-4b5e-b086-ba01d437cf2a"
      }
    },
    "owner": "rdo0711"
  }
}
