EXPO_PUBLIC_API_BASE_URL=https://asistente-hamilton-backend.onrender.com
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true

# Acceso simulado (login/registro sin backend). APAGADO: la app usa el backend real.
# Sólo para recorrer pantallas sin red; tras cambiarlo, `npx expo start -c`.
EXPO_PUBLIC_AUTH_SIMULADO=false

# Voz neuronal en la nube (POST /voz/sintetizar del backend, Azure AI Speech).
# false = voz del teléfono. Poner true SÓLO cuando Render tenga AZURE_SPEECH_KEY y
# AZURE_SPEECH_REGION (GET /salud -> "tts": true) y reiniciar con `npx expo start -c`.
# Con true, si el backend falla o tarda >8 s se usa igualmente la voz del teléfono.
EXPO_PUBLIC_TTS_NUBE=false
