EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true

# true = login/registro simulados sin backend (temporal)
EXPO_PUBLIC_AUTH_SIMULADO=false

# Voz neuronal en la nube (POST /voz/sintetizar del backend). false = voz del teléfono.
# Con true, si el backend falla o tarda >8 s se usa igualmente la voz del teléfono.
EXPO_PUBLIC_TTS_NUBE=false
